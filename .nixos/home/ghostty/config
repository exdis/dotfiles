font-family = FiraCode Nerd Font
font-size = 12
theme = alabaster-dark
cursor-style = block
shell-integration-features = no-cursor
window-decoration = none

# NOTE: cross-monitor Ghostty window cycling (cmd+2 / cmd+7 on macOS) is handled
# entirely outside Ghostty by home/skhd/yabai-focus-ghostty.sh, which asks yabai
# to focus the next Ghostty window. Ghostty has no window-cycling keybind action
# (only goto_tab / goto_split), so there is deliberately nothing to bind here.

