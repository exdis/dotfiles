font-family = FiraCode Nerd Font
font-size = 12
theme = alabaster-dark
cursor-style = block
shell-integration-features = no-cursor
window-decoration = none

# Cross-monitor Ghostty window cycling, driven by cmd+2 (see
# ~/.config/skhd/ghostty-focus-or-cycle.sh). This is a "private" combo that
# skhd synthesizes only when Ghostty is already frontmost -- so cmd+2 focuses
# Ghostty from elsewhere, and cycles its windows (across monitors) when you're
# already in it. Native cmd+` is left untouched for other apps.
keybind = cmd+ctrl+alt+2=goto_window:next
keybind = cmd+ctrl+alt+shift+2=goto_window:previous

