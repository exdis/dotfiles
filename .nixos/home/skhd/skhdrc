# skhd -- global app launcher / cross-Space focus hotkeys (standalone; NOT tied
# to komorebi).
#
# cmd+N focuses an app's MAIN window via the yabai-focus helper, which asks the
# yabai daemon (see hosts/darwin/default.nix + home/yabai/yabairc) to focus the
# app's largest window -- that is what keeps cmd+8 on Zen's browser window
# rather than its much smaller Picture-in-Picture video popup. yabai's
# persistent process reliably focuses windows on background Spaces / other
# displays. When yabai has no Accessibility reference for the window (Zen only
# publishes windows whose Space is visible, so a yabai restart while Zen sits on
# a background Space leaves it unreachable), the helper reveals that Space and
# raises the window over the PiP itself -- see the comments in yabai-focus.sh.
# If the app isn't running, the helper falls back to `open -b <bundle>`. Teams
# passes a 3rd "open" arg to use `open -b` ONLY -- recent Teams crashes on
# yabai's synthetic focus events.
#
# cmd+2 (Ghostty) is special: focus the laptop-display terminal first, then
# cycle through Ghostty windows on repeat (see yabai-focus-ghostty.sh).
# cmd+7 focuses Ghostty on the OTHER (external) monitors instead.
#
# cmd+digit is captured globally by skhd's event tap, so these intentionally
# override any app's own cmd+N (browser tabs etc.). Managed by the dev.exdis.skhd
# launchd agent (hosts/darwin/default.nix); skhd needs Accessibility on
# /opt/homebrew/bin/skhd, and yabai needs it on /opt/homebrew/bin/yabai.

cmd - 1 : /bin/sh "$HOME/.config/skhd/yabai-focus.sh" "Microsoft Outlook" com.microsoft.Outlook
cmd - 2 : /bin/sh "$HOME/.config/skhd/yabai-focus-ghostty.sh"
cmd - 7 : /bin/sh "$HOME/.config/skhd/yabai-focus-ghostty.sh" external
cmd - 3 : /bin/sh "$HOME/.config/skhd/yabai-focus.sh" "Microsoft Teams" com.microsoft.teams2 open
cmd - 4 : /bin/sh "$HOME/.config/skhd/yabai-focus.sh" "Telegram" ru.keepcoder.Telegram
cmd - 8 : /bin/sh "$HOME/.config/skhd/yabai-focus.sh" "Zen" app.zen-browser.zen
cmd - 9 : /bin/sh "$HOME/.config/skhd/yabai-focus.sh" "Microsoft Edge" com.microsoft.edgemac

# Swallow the remaining cmd+digit combos so apps never receive them (e.g. stop
# browsers switching tabs on cmd+5..7 / cmd+0). Binding to `true` (a shell no-op)
# does nothing, but skhd still consumes the keypress because a handler exists.
cmd - 5 : true
cmd - 6 : true
cmd - 0 : true
